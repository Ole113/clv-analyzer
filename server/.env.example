# Shared secret the extension sends as X-API-Key. Generate with: openssl rand -hex 24
API_KEY=change-me

DATABASE_URL="file:./clv.db"

# Minutes after game start before the closing line is captured (user preference: 1-2 min).
CLOSING_BUFFER_MINUTES=2
MAX_FETCH_ATTEMPTS=6
# A closing read this many minutes after kickoff is flagged as late rather than treated as clean.
STALE_CAPTURE_MINUTES=20
# Hours after kickoff before the first grading attempt.
GRADE_DELAY_HOURS=3
MAX_GRADE_ATTEMPTS=8
GRADE_POLL_MINUTES=15
