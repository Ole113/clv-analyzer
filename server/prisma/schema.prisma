// SQLite via Prisma. Note: SQLite does not support Prisma enums or the Json scalar, so status /
// side are validated strings (see src/lib/constants.ts) and raw snapshots are JSON text columns.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Bet {
  id String @id @default(cuid())

  // --- identity, captured at open time --------------------------------------
  site        String // ODDSJAM | PROPPROFESSOR
  fantasyBook String // prizepicks, underdog, ...
  sport       String?
  /// PLAYER_PROP | GAME_TOTAL | SPREAD | OTHER. The OddsJam rebet/fliff boards carry whole-game
  /// markets (spreads, totals, corners) rather than player props, so identity, CLV direction and
  /// grading all branch on this.
  marketType  String  @default("PLAYER_PROP")
  /// Null for game markets, which have no player.
  player      String?
  /// The board's own bet name, e.g. "Seattle Seahawks +5.5" or "Over 29.5". Kept verbatim so a
  /// game market is always displayable even when it does not decompose cleanly.
  selectionName String?
  /// For SPREAD: the team the line is quoted for, which is what the line is signed against.
  subjectTeam String?
  team        String?
  opponent    String?
  matchup     String?
  statMarket  String
  /// OVER | UNDER. Null for spreads, where the direction is carried by the signed line instead.
  side        String?
  /// True when captured from a Live board rather than Pre-Match. Live picks get no CLV verdict --
  /// the line taken is already mid-game, so a later read is not a "close" in any useful sense.
  isLive      Boolean @default(false)

  gameStartTime     DateTime?
  gameStartTimeText String?

  /// Site-provided row identifier. OddsJam: "Aaron Rodgers Over 14".
  /// PropProfessor: "NFL:GAME:Rams:49ers:1789086900:Player_Receiving_Yards:Puka_Nacua_Over_62.5".
  /// Both embed the line, which moves before kickoff, so matching uses matchKey.
  externalPropId String?
  /// Deterministic key over (site, book, sport, player, stat, side, gameStartTime) used to
  /// re-find the prop at closing time and to detect duplicate captures.
  matchKey String

  pageUrl      String?
  sourceDevice String?

  // --- open snapshot ---------------------------------------------------------
  takenLine           Float
  /// The site's own no-vig probability for this pick at capture time (0-1).
  openFairProb        Float?
  /// Pick'em payout price for one leg, when the board shows a DFS column.
  fantasyPrice        Int?
  /// True EV% at capture: fair probability x decimal payout - 1.
  openEvPercent       Float?
  openRawSnapshotJson String
  openCapturedAt      DateTime @default(now())
  openLines           OpenLine[]

  // --- scheduling ------------------------------------------------------------
  scheduledFetchAt DateTime?
  fetchAttempts    Int       @default(0)
  lastFetchError   String?
  lastFetchAt      DateTime?

  // --- close snapshot --------------------------------------------------------
  status               String    @default("PENDING")
  closeRawSnapshotJson String?
  closeCapturedAt      DateTime?
  closeLines           CloseLine[]

  // --- verdict ---------------------------------------------------------------
  avgClosingLine   Float?
  closingBookCount Int?
  closeFairProb    Float?
  /// True EV% measured against the closing market -- the number the analysis page ranks on.
  closeEvPercent   Float?
  /// Seconds between kickoff and when the closing board was actually read. Large values mean the
  /// browser was not running at kickoff, so the "closing" lines are really post-game lines.
  closingCaptureLagSeconds Int?
  edge             Float?
  beatClv          Boolean?

  // --- grading -----------------------------------------------------------------
  // Deliberately separate from `status`, which tracks only the closing-line capture: a pick can
  // be UNAVAILABLE for CLV and still have a real win/loss.
  /// WIN | LOSS | PUSH | UNGRADEABLE. Null means not graded yet.
  gradeResult      String?
  /// The player's actual stat for this market.
  actualValue      Float?
  gradedAt         DateTime?
  /// espn | mlb | manual
  gradeSource      String?
  /// Why it could not be graded, or the last failure detail.
  gradeReason      String?
  gradeScheduledAt DateTime?
  gradeAttempts    Int       @default(0)
  lastGradeAt      DateTime?
  /// Cached once resolved so re-grades skip the game lookup.
  externalGameId   String?
  /// Provenance for the grade: matched player, game, and a link to the public box score.
  gradeRawJson     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, scheduledFetchAt])
  @@index([gradeResult, gradeScheduledAt])
  @@index([matchKey])
  @@index([site, sport])
  @@index([isLive, marketType])
}

/// One sportsbook column as rendered in the row when the pick was captured.
model OpenLine {
  id                String  @id @default(cuid())
  betId             String
  bet               Bet     @relation(fields: [betId], references: [id], onDelete: Cascade)
  bookKey           String
  label             String?
  line              Float?
  price             Int?
  rawText           String
  /// Book logo as served by the source board, e.g. "https://www.propprofessor.com/fd.jpg".
  /// Captured at parse time so the dashboard does not need its own hand-maintained icon set.
  logoUrl           String?
  /// Whether this column feeds the closing average (real sportsbook quoting a line).
  includedInAverage Boolean @default(false)

  @@index([betId])
}

/// A single global settings row (id is always "singleton"). One row rather than a key/value table
/// because there is only ever one set of these -- a user, not a workspace -- and a single row is
/// simpler to read and upsert than a table that must always contain exactly one entry.
model AppSettings {
  id String @id @default("singleton")

  /// Comma-separated book keys (normalized, e.g. "fanduel,draftkings,pinnacle"), in the order the
  /// open/close snapshot tables should render them. A book missing from this list renders after
  /// the ones that are, in whatever order the board gave them.
  bookOrder String @default("")

  /// Off by default: the closing average is a plain mean, same as before this setting existed.
  useWeightedAverage Boolean @default(false)
  /// JSON object of bookKey -> weight (e.g. {"pinnacle":3,"fanduel":1}). SQLite has no Json
  /// scalar (see the note at the top of this file), so it is stored as text and parsed in
  /// src/lib/app-settings.ts. A book with no entry here defaults to weight 1 when weighting is
  /// on, so every book not explicitly weighted is effectively averaged evenly among itself.
  bookWeightsJson String @default("{}")

  updatedAt DateTime @updatedAt
}

/// One sportsbook column as rendered in the row at market close.
model CloseLine {
  id                String  @id @default(cuid())
  betId             String
  bet               Bet     @relation(fields: [betId], references: [id], onDelete: Cascade)
  bookKey           String
  label             String?
  line              Float?
  price             Int?
  rawText           String
  logoUrl           String?
  includedInAverage Boolean @default(false)

  @@index([betId])
}
