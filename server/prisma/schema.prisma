// SQLite via Prisma. Note: SQLite does not support Prisma enums or the Json scalar, so status /
// side are validated strings (see src/lib/constants.ts) and raw snapshots are JSON text columns.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Bet {
  id String @id @default(cuid())

  // --- identity, captured at open time --------------------------------------
  site        String // ODDSJAM | PROPPROFESSOR
  fantasyBook String // prizepicks, underdog, ...
  sport       String?
  /// PLAYER_PROP | GAME_TOTAL | SPREAD | OTHER. The OddsJam rebet/fliff boards carry whole-game
  /// markets (spreads, totals, corners) rather than player props, so identity, CLV direction and
  /// grading all branch on this.
  marketType  String  @default("PLAYER_PROP")
  /// Null for game markets, which have no player.
  player      String?
  /// The board's own bet name, e.g. "Seattle Seahawks +5.5" or "Over 29.5". Kept verbatim so a
  /// game market is always displayable even when it does not decompose cleanly.
  selectionName String?
  /// For SPREAD: the team the line is quoted for, which is what the line is signed against.
  subjectTeam String?
  team        String?
  opponent    String?
  matchup     String?
  statMarket  String
  /// OVER | UNDER. Null for spreads, where the direction is carried by the signed line instead.
  side        String?
  /// True when captured from a Live board rather than Pre-Match. Live picks get no CLV verdict --
  /// the line taken is already mid-game, so a later read is not a "close" in any useful sense.
  isLive      Boolean @default(false)

  gameStartTime     DateTime?
  gameStartTimeText String?

  /// Site-provided row identifier. OddsJam: "Aaron Rodgers Over 14".
  /// PropProfessor: "NFL:GAME:Rams:49ers:1789086900:Player_Receiving_Yards:Puka_Nacua_Over_62.5".
  /// Both embed the line, which moves before kickoff, so matching uses matchKey.
  externalPropId String?
  /// Deterministic key over (site, book, sport, player, stat, side, gameStartTime) used to
  /// re-find the prop at closing time and to detect duplicate captures.
  matchKey String

  pageUrl      String?
  sourceDevice String?

  // --- open snapshot ---------------------------------------------------------
  takenLine           Float
  /// The site's own no-vig probability for this pick at capture time (0-1).
  openFairProb        Float?
  /// Pick'em payout price for one leg, when the board shows a DFS column.
  fantasyPrice        Int?
  /// True EV% at capture: fair probability x decimal payout - 1.
  openEvPercent       Float?
  openRawSnapshotJson String
  openCapturedAt      DateTime @default(now())
  openLines           OpenLine[]

  // --- scheduling ------------------------------------------------------------
  scheduledFetchAt DateTime?
  fetchAttempts    Int       @default(0)
  lastFetchError   String?
  lastFetchAt      DateTime?
  /// Held while an extension is reading this pick's close. Without it the 60s poll re-serves a
  /// DUE pick every minute while the previous read is still in flight, so the same pick gets read
  /// several times over and reported several times. Expired leases are simply re-servable.
  leasedUntil      DateTime?

  // --- close snapshot --------------------------------------------------------
  status               String    @default("PENDING")
  closeRawSnapshotJson String?
  closeCapturedAt      DateTime?
  closeLines           CloseLine[]

  // --- verdict ---------------------------------------------------------------
  avgClosingLine   Float?
  closingBookCount Int?
  closeFairProb    Float?
  /// True EV% measured against the closing market -- the number the analysis page ranks on.
  closeEvPercent   Float?
  /// Seconds between kickoff and when the closing board was actually read. Large values mean the
  /// browser was not running at kickoff, so the "closing" lines are really post-game lines.
  closingCaptureLagSeconds Int?
  edge             Float?
  beatClv          Boolean?
  /// Price-based CLV: de-vigged win probability at close minus at open, in probability points.
  /// Independent of `edge`, which is line-based and reads 0 on markets where only the price moved
  /// -- a total parked at 47.5 while the price drifts -110 to -130 has moved hard against one side
  /// and no line-based metric can see it. Null until both ends carry a fair probability.
  priceEdge        Float?
  /// JSON array of book keys dropped from the closing average as outliers, e.g. ["fanatics"].
  /// The same set `lastFetchError` describes in prose, kept structurally so exclusions can be
  /// counted across picks: one book showing up again and again is a mis-mapped bookKey, not a
  /// market that happened to be noisy on each of those nights. SQLite has no Json scalar (see the
  /// note at the top of this file), so it is stored as text.
  excludedBooks    String?
  /// How the closing number was obtained. PROPPROFESSOR_SCREEN reads the full odds screen, which
  /// lists every market whether or not it still has edge; OPTIMIZER_LEGACY is the old read off the
  /// edge-filtered Fantasy Optimizer, which could only ever find picks whose edge had NOT gone.
  /// The screen shows more books, so the two are not directly comparable and must stay separable.
  closingSourceSite String?
  closingSourceUrl  String?
  /// BOOK_CONSENSUS | BOARD_LINE
  closingMethod     String?

  // --- grading -----------------------------------------------------------------
  // Deliberately separate from `status`, which tracks only the closing-line capture: a pick can
  // be UNAVAILABLE for CLV and still have a real win/loss.
  /// WIN | LOSS | PUSH | UNGRADEABLE. Null means not graded yet.
  gradeResult      String?
  /// The player's actual stat for this market.
  actualValue      Float?
  gradedAt         DateTime?
  /// espn | mlb | manual
  gradeSource      String?
  /// Why it could not be graded, or the last failure detail.
  gradeReason      String?
  gradeScheduledAt DateTime?
  gradeAttempts    Int       @default(0)
  lastGradeAt      DateTime?
  /// Cached once resolved so re-grades skip the game lookup.
  externalGameId   String?
  /// Provenance for the grade: matched player, game, and a link to the public box score.
  gradeRawJson     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, scheduledFetchAt])
  @@index([gradeResult, gradeScheduledAt])
  @@index([matchKey])
  @@index([site, sport])
  @@index([isLive, marketType])
}

/// One sportsbook column as rendered in the row when the pick was captured.
model OpenLine {
  id                String  @id @default(cuid())
  betId             String
  bet               Bet     @relation(fields: [betId], references: [id], onDelete: Cascade)
  bookKey           String
  label             String?
  line              Float?
  price             Int?
  rawText           String
  /// Book logo as served by the source board, e.g. "https://www.propprofessor.com/fd.jpg".
  /// Captured at parse time so the dashboard does not need its own hand-maintained icon set.
  logoUrl           String?
  /// Whether this column feeds the closing average (real sportsbook quoting a line).
  includedInAverage Boolean @default(false)

  @@index([betId])
}

/// A single global settings row (id is always "singleton"). One row rather than a key/value table
/// because there is only ever one set of these -- a user, not a workspace -- and a single row is
/// simpler to read and upsert than a table that must always contain exactly one entry.
model AppSettings {
  id String @id @default("singleton")

  /// Comma-separated book keys (normalized, e.g. "fanduel,draftkings,pinnacle"), in the order the
  /// open/close snapshot tables should render them. A book missing from this list renders after
  /// the ones that are, in whatever order the board gave them.
  bookOrder String @default("")

  /// Off by default: the closing average is a plain mean, same as before this setting existed.
  useWeightedAverage Boolean @default(false)
  /// JSON object of bookKey -> weight (e.g. {"pinnacle":3,"fanduel":1}). SQLite has no Json
  /// scalar (see the note at the top of this file), so it is stored as text and parsed in
  /// src/lib/app-settings.ts. A book with no entry here defaults to weight 1 when weighting is
  /// on, so every book not explicitly weighted is effectively averaged evenly among itself.
  bookWeightsJson String @default("{}")

  /// Off by default, for the same reason the manual weighting above is: turning it on changes the
  /// closing average, and therefore every CLV number already recorded against it. When on, a book
  /// with real depth behind its quote counts for more than one publishing none -- but a weight set
  /// by hand above always wins over the automatic one, because an explicit preference should not
  /// be quietly overridden by a number scraped off the screen.
  useLiquidityWeighting Boolean @default(false)

  /// "system" | "light" | "dark". Default "system" so a user who never opens Settings still gets
  /// their device's own preference rather than being locked into whichever palette shipped first.
  themePreference String @default("system")

  /// The Odds API key, for the Odds modal's second source. Empty means "not configured", which the
  /// modal says inside that tab rather than hiding the tab.
  ///
  /// Here rather than in process.env, which was the other candidate and follows the API_KEY
  /// precedent in lib/auth.ts. The deciding factor was that the person who has to paste this in is
  /// not necessarily the person who can edit a .env and restart Node -- every install is
  /// single-tenant and brings its own free account, so this is a value each user sets for
  /// themselves, which makes it a setting like any other. The cost of that choice is real and worth
  /// stating: the key is in clv.db and therefore in every backup of it, so it should be treated as
  /// disclosed if the database ever is. It grants nothing but that account's own read quota.
  oddsApiKey String @default("")

  /// Bankroll the Kelly calculator stakes against, in whole cents. Cents rather than dollars
  /// because SQLite has no decimal type and a float bankroll rounds visibly once it is multiplied
  /// by a Kelly fraction. 0 means "not set", which is why the calculator asks for one.
  bankrollCents Int @default(0)

  /// Fraction of full Kelly to stake. 0.25 -- quarter Kelly -- is the usual compromise between
  /// growth and the variance full Kelly actually carries.
  kellyMultiplier Float @default(0.25)

  /// Dollars per unit, in whole cents, for the "units" figure. 0 means 1% of bankroll.
  unitSizeCents Int @default(0)

  /// Comma-separated OddsJam board names -- the slug in /fantasy-odds/<slug> -- that get the Kelly
  /// button. An allowlist, because Kelly needs a real two-sided price and the pick'em boards
  /// (PrizePicks, Underdog, Sleeper) quote a fixed payout, where "30 points off fair" means
  /// nothing. Stored here rather than in the extension so both surfaces read one list.
  kellyBoards String @default("")

  updatedAt DateTime @updatedAt
}

/// One sportsbook column as rendered in the row at market close.
model CloseLine {
  id                String  @id @default(cuid())
  betId             String
  bet               Bet     @relation(fields: [betId], references: [id], onDelete: Cascade)
  bookKey           String
  label             String?
  line              Float?
  price             Int?
  rawText           String
  logoUrl           String?
  /// Money resting behind this quote at close, where the source reported it. 0 means the book
  /// publishes no depth (most sportsbooks); null means the source did not say. Only the odds
  /// screen supplies this, so rows captured from the optimizer carry null.
  liquidity         Float?
  /// This book's own de-vigged probability for the side taken, where it quoted both sides. Stored
  /// per book rather than only as the row's consensus so a suspect fair price can be traced back
  /// to the quote that produced it.
  fairProbability   Float?
  includedInAverage Boolean @default(false)

  @@index([betId])
}

/// A pick the extension tried to send but could not be tracked -- a validation rejection or a
/// thrown exception during ingest. Kept separately from Bet so a bad payload never becomes a
/// phantom row, but the reason and the payload that produced it are not just lost to a server log
/// nobody is watching -- they show up in Settings so a rejected tick can actually be debugged.
model IngestFailure {
  id          String   @id @default(cuid())
  occurredAt  DateTime @default(now())
  /// "validation" (the payload failed the zod schema), "shape" (well-formed but an impossible
  /// combination, e.g. a player prop with no player), or "exception" (ingestSnapshot itself threw).
  stage       String
  reason      String
  site        String?
  fantasyBook String?
  sport       String?
  player      String?
  statMarket  String?
  /// The row that failed, as sent by the extension. SQLite has no Json scalar (see the note at the
  /// top of this file), so it is stored as text and truncated defensively -- this is for a human
  /// reading a specific failure, not for replaying it.
  payloadJson String?
  /// Stack trace, present only when the failure was a thrown exception rather than a rejection.
  stack       String?

  @@index([occurredAt])
}

// ---------------------------------------------------------------------------------------------
// Pikkit import.
//
// A second, deliberately disjoint dataset. `Bet` above is a pick the extension captured, and every
// number on it is line-based: it knows the closing consensus and nothing about money. A Pikkit row
// is the opposite -- it knows exactly what was staked and returned, and (for most books) nothing
// about the close. Fusing them into one table would mean a row where more than half the columns
// are structurally null and every aggregate needs a "which kind is this" branch, so they stay
// apart and the analysis page switches between them instead.
// ---------------------------------------------------------------------------------------------

/// One bet as exported by Pikkit -- a whole slip, not a leg.
model PikkitBet {
  id String @id @default(cuid())

  /// The export's own `bet_id`. Unique, because the import upserts on it: dropping in a newer
  /// export settles the bets that were still PLACED last time rather than duplicating them.
  externalId String @unique

  sportsbook String
  /// STRAIGHT | PARLAY, from the export's `type`.
  betType    String
  /// WIN | LOSS | VOID | PENDING, narrowed from the export's SETTLED_WIN/LOSS/VOID and PLACED.
  result     String

  /// Decimal, as exported. Pikkit stores decimal odds even for American-priced books.
  oddsDecimal    Float
  /// The closing price, decimal. Null on roughly two thirds of rows -- most DFS books publish no
  /// close to Pikkit at all -- so every metric built on it reports its own coverage.
  closingDecimal Float?
  /// Pikkit's own EV as a fraction (0.0484 = +4.84%), where it computed one.
  pikkitEv       Float?

  stake  Float
  /// Net profit: a 15 stake at 6.0 that wins reads 75, not 90. Zero on a void.
  profit Float

  placedAt  DateTime
  settledAt DateTime?

  /// The whole `bet_info` string verbatim, legs joined by " | ". Kept even though the legs are
  /// also parsed out below, because leg parsing is per-book regex and a format that changes must
  /// stay re-parseable from what was imported rather than needing a fresh export.
  betInfo String
  isLive  Boolean @default(false)

  /// The export's `sports` / `leagues` columns, verbatim. They are deduplicated *sets*, not one
  /// entry per leg -- a three-leg slip can list two leagues -- so they are bet-level tags and a
  /// leg can never be attributed to one of them. Split on " | " at read time.
  sportsRaw  String
  leaguesRaw String

  legCount Int

  /// A loss that cost nothing: `result` is LOSS but `profit` is 0, which in practice means a
  /// promo or free bet rather than real money at risk. Flagged rather than dropped, because it
  /// would otherwise quietly inflate the win rate's denominator while contributing no loss to ROI.
  noRisk Boolean @default(false)

  importedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  legs PikkitLeg[]

  @@index([placedAt])
  @@index([sportsbook])
  @@index([result])
}

/// One leg of a Pikkit slip, parsed out of `bet_info`.
///
/// There is no per-leg result anywhere in the export -- only the slip settles -- so these rows can
/// never carry a win or a loss of their own. They exist to answer exposure questions ("what did
/// slips containing a receiving-yards leg return"), which is a different and weaker claim than a
/// leg hit rate, and the UI says so wherever it uses them.
model PikkitLeg {
  id    String    @id @default(cuid())
  betId String
  bet   PikkitBet @relation(fields: [betId], references: [id], onDelete: Cascade)

  legIndex Int
  rawText  String

  /// OVER | UNDER, collapsed from every spelling the books use: Over/Under, Higher/Lower, O/U.
  /// Null when the leg is a game market with no side (a spread carries its direction in the line).
  side   String?
  line   Float?
  player String?
  /// The market as the book spelled it, e.g. "Receiving Yds".
  market String?
  /// `marketFilterKey(market)` -- what collapses "Receiving Yds", "receiving-yards" and
  /// "Player Receiving Yards" onto one bucket so a breakdown is not seven rows of one concept.
  marketKey String?
  matchup   String?

  @@index([betId])
  @@index([marketKey])
}
