{
  "manifest_version": 3,
  "name": "CLV Analyzer Capture",
  "version": "0.2.0",
  "description": "Adds a CLV checkbox column to the OddsJam Fantasy Optimizer and snapshots the board when you tick a pick.",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://fantasy.oddsjam.com/*",
    "https://oddsterminal.org/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "options_page": "options/options.html",
  "content_scripts": [
    {
      "matches": [
        "https://fantasy.oddsjam.com/fantasy-odds/*"
      ],
      "js": [
        "content/oddsjam.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://oddsjam.com/game/*",
        "https://oddsjam.com/*/odds*"
      ],
      "js": [
        "content/oddsjam-site.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
