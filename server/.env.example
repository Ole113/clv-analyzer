# Shared secret the extension sends as X-API-Key. Generate with: openssl rand -hex 24
API_KEY=change-me

DATABASE_URL="file:./clv.db"

# The closing read is a window BEFORE kickoff, not a single shot after it (see lib/constants.ts).
# These are the edges of that window, in minutes.
CLOSING_READ_OPENS_MINUTES_BEFORE=8
CLOSING_READ_TARGET_MINUTES_BEFORE=3
CLOSING_READ_CLOSES_MINUTES_AFTER=5
# How long a pick handed to one browser is not handed to another.
CLOSING_LEASE_MINUTES=5
MAX_FETCH_ATTEMPTS=6
# A closing read this many minutes after kickoff is flagged as late rather than treated as clean.
STALE_CAPTURE_MINUTES=20
# Hours after kickoff before the first grading attempt.
GRADE_DELAY_HOURS=3
MAX_GRADE_ATTEMPTS=8
GRADE_POLL_MINUTES=15
